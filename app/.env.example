DATABASE_URL="postgresql://user:password@localhost:5432/brewtoad_archive"

# --- App sign-in (Auth.js / NextAuth) ---
# Generate a signing secret with:  openssl rand -base64 33
AUTH_SECRET=""
# Public URL of the deployment (used to build OAuth callback URLs).
AUTH_URL="https://REPLACE-WITH-LIVE-URL"
# Google: create OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI:  <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Apple: https://developer.apple.com (Sign in with Apple). AUTH_APPLE_SECRET is a
# JWT you generate from your Apple private key; Apple caps its lifetime at ~6
# months, so it must be regenerated periodically. Redirect URI:
#   <AUTH_URL>/api/auth/callback/apple
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""
