// Data model for WortHogg. Mirrors docs/data-model.md - keep
// both in sync. Loaded from scraper output (data/parsed) via a one-time/
// periodic import script (app/prisma/import.ts), never fetched live from
// Wayback at request time.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Brewer {
  id               String   @id @default(cuid())
  originalUsername String   @unique
  profileUrl       String?
  sourceTimestamp  String?
  createdAt        DateTime @default(now())

  recipes          Recipe[]
  takedownRequests TakedownRequest[]

  @@index([originalUsername])
}

model Recipe {
  id                String   @id @default(cuid())
  slug              String   @unique

  title             String?
  styleName         String?

  // BrewToad's own computed "Anticipated" stats, as displayed on the
  // archived page - not recomputed from ingredients at parse time (that
  // recomputation happens separately as a QA cross-check, see
  // scraper/validate_calculator.py and lib/calculator).
  og                Float?
  fg                Float?
  ibu               Float?
  srm               Float?
  abv               Float?
  ibuFormula        String?

  batchSizeDisplay   String?
  boilTimeDisplay    String?
  efficiencyDisplay  String?
  notesText          String?

  brewerId          String?
  brewer            Brewer?  @relation(fields: [brewerId], references: [id])

  // Wayback provenance - displayed publicly ("Archived from brewtoad.com on
  // [date] via Wayback Machine") and doubles as the citation a takedown
  // claimant points at.
  sourceUrl         String
  sourceTimestamp   String
  sourceDigest      String?
  parseSource       String   // "html" | "xml" | "html+xml_crossvalidated"
  parseConfidence   Float

  // Set by an approved takedown request; suppresses public visibility
  // without hard-deleting the row (audit trail preserved).
  isHidden          Boolean  @default(false)
  takedownStatus    String?  // null | "pending" | "approved" | "rejected"

  // BrewToad's "make a clone" feature spawned independent recipes that are
  // byte-identical copies. prisma/dedupe.ts consolidates each set of clones
  // into one canonical row; cloneCount records how many identical copies were
  // folded in (0 = never had duplicates).
  cloneCount        Int      @default(0)

  scrapedAt         DateTime @default(now())

  fermentables      RecipeFermentable[]
  hops              RecipeHop[]
  yeasts            RecipeYeast[]
  miscs             RecipeMisc[]
  comments          RecipeComment[]
  takedownRequests  TakedownRequest[]
  pitchingProtocol  RecipePitchingProtocol?

  @@index([styleName])
  @@index([abv])
  @@index([ibu])
  @@index([brewerId])
  @@index([isHidden, scrapedAt])
}

model RecipeFermentable {
  // Kept as a plain column (still cuid-defaulted) so existing code that reads
  // `f.id` — React list keys, lookup maps — keeps working untouched. It is no
  // longer the primary key: the cuid PK was a 37 MB btree index that nothing
  // ever queried by (every access is by recipeId). Identity is the composite
  // below, which also serves as the recipeId lookup index, so the standalone
  // @@index([recipeId]) is gone too. (recipeId, sortOrder) is unique across
  // all 513k rows — verified before migrating.
  id            String  @default(cuid())
  recipeId      String
  recipe        Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  name          String
  amountDisplay String?
  amountLb      Float?  // normalized to lb regardless of source display unit
  percent       String?
  maltster      String?
  use           String?
  ppg           Float?
  colorLovibond Float?
  refUrl        String? // links to FermentableRef.externalId when resolvable
  sortOrder     Int     @default(0)

  @@id([recipeId, sortOrder])
}

model RecipeHop {
  // See RecipeFermentable: id demoted from primary key to a plain column to
  // shed a 33 MB unused index. (recipeId, sortOrder) is unique across all
  // 453k rows and is now both the identity and the recipeId lookup index.
  id            String  @default(cuid())
  recipeId      String
  recipe        Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  name          String
  amountDisplay String?
  amountOz      Float?  // normalized to oz regardless of source display unit
  timeDisplay   String?
  timeMinutes   Float?
  use           String?
  form          String?
  alphaAcidPct  Float?
  refUrl        String?
  sortOrder     Int     @default(0)

  @@id([recipeId, sortOrder])
}

model RecipeYeast {
  // Deliberately keeps its cuid primary key. Unlike the fermentable/hop
  // junctions it has no sortOrder column and no naturally-unique combination
  // (a recipe can list the same yeast twice), so re-keying it would mean a
  // mass row-update to synthesise an ordinal — heap bloat we won't risk near
  // the storage cap for the sake of only ~9 MB.
  id             String  @id @default(cuid())
  recipeId       String
  recipe         Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  name           String
  labProduct     String?
  attenuationPct Float?
  refUrl         String?

  @@index([recipeId])
}

// A recipe's chosen yeast pitching + propagation protocol, made a permanent
// part of the recipe. One-to-one with Recipe. Stores the raw calculator
// inputs (see lib/pitching/formulas.ts) so the embedded calculator on the
// recipe page can reproduce the exact plan; results are recomputed, never
// stored. Populated via the admin-gated save action, not the Wayback import.
model RecipePitchingProtocol {
  id               String   @id @default(cuid())
  recipeId         String   @unique
  recipe           Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  // Batch target
  volume           Float
  volumeUnit       String   // "gal" | "L"
  og               Float
  pitchType        String   // "ale" | "hybrid" | "lager"

  // Yeast source
  source           String   // "liquid" | "dry" | "slurry"
  packs            Float?
  grams            Float?
  slurryMl         Float?
  yeastFractionPct Float?
  ageDays          Float?
  decayModel       String   // classic | optimistic | whiteLabs | wyeast

  // Starter / propagation
  starterType      String   // none | simple | simpleO2 | shaking | aeration | stirPlate
  starterMl        Float?

  notes            String?
  updatedAt        DateTime @updatedAt
  updatedBy        String?
}

model RecipeMisc {
  id       String  @id @default(cuid())
  recipeId String
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  name     String
  amount   String?
  use      String?
  time     String?

  @@index([recipeId])
}

model RecipeComment {
  id                  String  @id @default(cuid())
  recipeId            String
  recipe              Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  originalCommentId   String? // BrewToad's own comment id, e.g. "18811"
  commenter           String?
  commenterProfileUrl String?
  timestampDisplay    String?
  text                String
  parentCommentId     String? // preserves thread structure (flattened list)

  @@index([recipeId])
}

// Ingredient reference database scraped from /generic-fermentables,
// /hops, /yeasts - powers the calculator's ingredient picker (M6) and
// backfills missing per-recipe properties.
model FermentableRef {
  id            String  @id @default(cuid())
  externalId    String  @unique // numeric id from /generic-fermentables/<id>
  name          String
  ppg           Float?
  colorLovibond Float?
  type          String?
  origin        String?
}

model HopRef {
  id           String  @id @default(cuid())
  externalId   String  @unique // numeric id from /hops/<id>
  name         String
  alphaAcidPct Float?
}

model YeastRef {
  id             String  @id @default(cuid())
  externalId     String  @unique // numeric id from /yeasts/<id>
  name           String
  lab            String?
  attenuationPct Float?
}

model TakedownRequest {
  id             String    @id @default(cuid())
  recipeId       String?
  recipe         Recipe?   @relation(fields: [recipeId], references: [id])
  brewerId       String?
  brewer         Brewer?   @relation(fields: [brewerId], references: [id])

  requesterName  String
  requesterEmail String
  requestReason  String
  status         String    @default("pending") // pending | approved | rejected | completed
  submittedAt    DateTime  @default(now())
  resolvedAt     DateTime?
  resolvedBy     String?
  notes          String?

  @@index([status])
}

// --- Competition style guidelines archive (BJCP / BA(WBC+GABF) / AWS) ---

model GuidelineEdition {
  id          String              @id // e.g. "bjcp-2021", "ba-2019", "aws-2025"
  system      String // BJCP | BA | AWS | SPIRITS | SAKE | MF | CHINA | KOREA ...
  year        Int
  title       String
  // What kind of authority this is, so the UI can distinguish a judging
  // guideline from a statute: competition | legal-standard | club | traditional
  sourceType  String?
  sourceUrl   String
  attribution String
  categories  GuidelineCategory[]

  @@unique([system, year])
}

model GuidelineCategory {
  id        String           @id
  editionId String
  edition   GuidelineEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  code      String?
  name      String
  // The beverage family this category belongs to (see lib/beverages.ts):
  // beer | wine | cider | mead | sake | spirit | fortified | traditional.
  // Category-level because one edition (BJCP, FERMENTED) can span several.
  beverage  String?
  sortOrder Int
  styles    GuidelineStyle[]

  @@index([editionId])
  @@index([beverage])
}

model GuidelineStyle {
  id          String            @id
  categoryId  String
  category    GuidelineCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  code        String?
  name        String
  sortOrder   Int
  ogMin       Float?
  ogMax       Float?
  fgMin       Float?
  fgMax       Float?
  ibuMin      Float?
  ibuMax      Float?
  srmMin      Float?
  srmMax      Float?
  abvMin      Float?
  abvMax      Float?
  impression  String?
  aroma       String?
  appearance  String?
  flavor      String?
  mouthfeel   String?
  comments    String?
  history     String?
  ingredients String?
  comparison  String?
  examples    String?
  tags        String?
  // The document this style's figures were read out of, when it differs from
  // the edition's. Traditional editions cite per style, not per edition.
  sourceUrl   String?

  @@index([categoryId])
  @@index([name])
}

// --- Yeast / culture database (beer, wine, mead, cider, spirits, wild) ---
// A curated, sourced catalog of alcohol-producing microbes and their brewing
// specs. Populated from data/yeasts/*.json via load-yeasts.mjs (prod, Neon
// HTTPS) / prisma/import-yeasts.ts (local), NOT from the Wayback import. Every
// strain records a sourceUrl; specs are transcribed from makers' spec sheets,
// never invented. Distinct from the thin per-recipe RecipeYeast rows.

model YeastLab {
  id          String        @id // e.g. "lallemand", "white-labs", "angel-yeast"
  name        String
  country     String?
  region      String?
  url         String?
  description String?
  sortOrder   Int           @default(0)
  strains     YeastStrain[]

  @@index([country])
}

model YeastStrain {
  id          String   @id // e.g. "fermentis-us-05", "wyeast-1084"
  labId       String
  lab         YeastLab @relation(fields: [labId], references: [id], onDelete: Cascade)

  productCode String? // "US-05", "WLP001", "1056"
  name        String
  aliases     String[] @default([])

  form        String // dry | liquid | slurry | culture
  species     String // scientific, e.g. "Saccharomyces cerevisiae", "Brettanomyces bruxellensis"

  // What you can make with it, and which styles the maker recommends.
  uses             String[] @default([]) // beer | wine | mead | cider | rum | whiskey | moonshine | neutral | sake | wild
  recommendedStyles String[] @default([]) // maker's listed styles, normalized names
  styleTags        String[] @default([]) // coarse tags: stout, ipa, saison, hazy, kveik...

  // Brewing-calculator specs (nullable - sparse sources null-fill).
  attenuationMin      Float?
  attenuationMax      Float?
  tempMinF            Float?
  tempMaxF            Float?
  tempMinC            Float?
  tempMaxC            Float?
  flocculation        String? // low | medium | medium-high | high | very high
  alcoholToleranceMin Float?
  alcoholToleranceMax Float?

  // Pitching-calculator inputs.
  cellsPerUnit Float? // billion viable cells per unit
  unitLabel    String? // pack | vial | g
  optimalPitchNote String?

  isBlend         Boolean  @default(false)
  blendComponents String[] @default([])

  description String?
  flavorNotes String?
  sourceUrl   String
  attribution String?
  sortOrder   Int      @default(0)

  // Provenance. specBasis is what kind of evidence the numeric fields above
  // rest on (vendor-tds | peer-reviewed | club-guide | vendor-web | regulation);
  // sourceId keys into data/sources/registry.json; sourceNote records what the
  // cited document does and does not support, so a null spec reads as "nobody
  // published this figure" rather than as an oversight.
  specBasis  String?
  sourceId   String?
  sourceNote String?

  @@index([labId])
  @@index([name])
  @@index([species])
  @@index([specBasis])
}

// --- Fermentable & hop database ------------------------------------------
// Curated from maltster/grower spec sheets, and - for the long tail of
// adjuncts that have no brewing datasheet (rice, cereal, candy, fruit, juice,
// palm sugar) - derived from Nutrition Facts panels via lib/fermentable-math.ts.
// The nutrition inputs are stored alongside the derived PPG so the figure is
// auditable rather than asserted. Loaded from data/fermentables/*.json and
// data/hops/*.json; distinct from the thin scraped RecipeFermentable/RecipeHop.

model Fermentable {
  id       String  @id // e.g. "weyermann-pilsner", "adjunct-arborio-rice"
  name     String
  aliases  String[] @default([])
  brand    String? // maltster / producer, null for generic commodity items
  category String // base-malt | specialty-malt | adjunct-grain | sugar | syrup | fruit | juice | cereal | extract | other
  type     String // grain | extract | sugar | fruit | adjunct
  origin   String?

  // Extract & colour
  ppg           Float? // points per pound per gallon
  ppgMin        Float? // fruit and honey vary too much for a single figure
  ppgMax        Float?
  yieldPct      Float? // extract as % of sucrose
  colorLovibond Float?
  pfundColorMm  Float? // honey grading scale, mm

  // Sugar-mass model. Beer works from PPG and mash efficiency; wine, cider
  // and mead work from the sugar actually present, which for real fruit is a
  // range rather than a number. Both paths reduce to the same identity:
  // PPG = 46 x sugar mass fraction.
  sugarGPer100g    Float? // whole ingredient, as weighed
  sugarGPer100gMin Float?
  sugarGPer100gMax Float?
  juiceBrix        Float? // degrees Brix of the pressed juice
  juiceBrixMin     Float?
  juiceBrixMax     Float?
  juiceYieldPct    Float? // mass % of the whole fruit recoverable as juice
  moisturePct      Float? // honey and syrups

  // Must chemistry — what you have to correct before pitching.
  titratableAcidityGPerL    Float?
  titratableAcidityMinGPerL Float?
  titratableAcidityMaxGPerL Float?
  dominantAcid              String? // malic | citric | tartaric | mixed
  phTypical                 Float?
  phMin                     Float?
  phMax                     Float?
  pectinLevel               String? // low | medium | high | very high
  tanninLevel               String?
  fruitGroup                String? // pome | stone | berry | citrus | tropical | melon | grape | dried | other
  species                   String? // Vitis vinifera, Hybrid, Vitis labrusca…
  grapeColor                String? // red | white

  // How it behaves in the brewhouse
  requiresConversion   Boolean @default(false) // starch needing mash/enzymes
  requiresGelatinization Boolean @default(false) // cereal mash / pre-boil
  diastaticPowerLintner Float?
  fermentabilityPct    Float? // how much of the extract yeast can take
  maxBatchPct          Float? // recommended ceiling as % of grist

  // Provenance of the PPG figure, and the nutrition inputs when derived.
  ppgBasis      String? // maltster | nutrition | literature | measured
  servingSizeG  Float?
  totalCarbG    Float?
  fiberG        Float?

  uses        String[] @default([]) // beer | wine | mead | cider | whiskey | rum | moonshine
  styleTags   String[] @default([])
  description String?
  flavorNotes String?
  usageNotes  String?
  sourceUrl   String
  attribution String?
  sortOrder   Int      @default(0)

  @@index([category])
  @@index([name])
  @@index([brand])
  @@index([fruitGroup])
}

// Everything that goes into a fermenter without contributing fermentable
// sugar: acids, nutrients, enzymes, finings, tannins, wood, stabilisers and
// botanicals. Curated in data/additives/*.json.
model Additive {
  id       String   @id // e.g. "acid-tartaric", "nutrient-fermaid-o"
  name     String
  aliases  String[] @default([])
  category String // acid | deacidifier | nutrient | enzyme | fining | tannin | wood | stabiliser | botanical
  subtype  String?
  uses     String[] @default([]) // beer | wine | mead | cider | spirits

  // Dosing, and what a gram of it actually does — this is what lets the
  // calculator answer "how much do I add" rather than just listing products.
  doseMinGPerL Float?
  doseMaxGPerL Float?
  doseUnit     String? // g/L | mL/L | tablet/gal

  effectMetric          String? // TA | pH | YAN | SO2 | tannin
  effectPerGramPerLitre Float? // signed: negative for deacidifiers
  effectUnit            String?
  contactTime           String?

  description String
  usageNotes  String?
  cautions    String?
  sourceUrl   String
  attribution String?
  sortOrder   Int     @default(0)

  @@index([category])
  @@index([name])
}

model Hop {
  id      String   @id // e.g. "citra", "hallertau-mittelfrueh"
  name    String
  aliases String[] @default([])
  country String?
  purpose String? // aroma | bittering | dual

  alphaMin      Float?
  alphaMax      Float?
  betaMin       Float?
  betaMax       Float?
  cohumuloneMin Float?
  cohumuloneMax Float?

  totalOilMin      Float? // mL per 100 g
  totalOilMax      Float?
  myrcenePct       Float?
  humulenePct      Float?
  caryophyllenePct Float?
  farnescenePct    Float?

  aromaDescriptors String[] @default([])
  substitutes      String[] @default([])
  styleTags        String[] @default([])

  breeder      String?
  yearReleased Int?
  description  String?
  usageNotes   String?
  sourceUrl    String
  attribution  String?
  sortOrder    Int      @default(0)

  @@index([country])
  @@index([name])
  @@index([purpose])
}

// --- Water profile database ----------------------------------------------
// Historic brewing-city water and modern target profiles, in ppm (mg/L). The
// six brewing ions are stored; residual alkalinity and the sulfate:chloride
// balance are derived in lib/water.ts. Loaded from data/water/*.json.
model WaterProfile {
  id       String  @id // e.g. "burton-upon-trent", "target-yellow-balanced"
  name     String
  kind     String // classic-city | modern-city | style-target
  country  String?
  region   String?

  calcium     Float? // Ca2+ ppm
  magnesium   Float? // Mg2+ ppm
  sodium      Float? // Na+ ppm
  chloride    Float? // Cl- ppm
  sulfate     Float? // SO4 2- ppm
  bicarbonate Float? // HCO3- ppm

  description  String?
  bestForStyles String[] @default([])
  styleTags    String[] @default([])
  sourceUrl    String
  attribution  String?
  sortOrder    Int      @default(0)

  @@index([kind])
  @@index([name])
}

// --- Accounts (Auth.js / NextAuth) ---------------------------------------
// User records for the app's own login (Google, Apple, …), distinct from the
// admin-token gate and from the scraped-archive `Brewer` rows. Sessions are
// JWT (a signed cookie), NOT database-backed, so an authenticated request
// costs no query — deliberate, given the free-tier database pressure. The
// Session table below exists for the adapter's type contract and future use;
// the JWT strategy does not write to it per request.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}
