__pycache__/
*.pyc
.venv/
node_modules/
.next/
*.tsbuildinfo
.env
.env.local
# Loader credentials. The data loaders read NEON_URL from a throwaway env file
# written next to them and deleted afterwards; if a run ever dies between those
# two steps, this line is what stops the connection string reaching a public
# commit.
.neon.env
*.neon.env

# Pipeline artifacts - large, regenerable from web.archive.org, not source
/data/raw/
/data/cdx/
!/data/cdx/.gitkeep
!/data/raw/.gitkeep
/data/*.log
/data/parsed/recipes_full.jsonl
/data/manifest_recipes.jsonl
!/data/snapshots/
/data/warcs/
/data/PAUSE_SCRAPER
/data/parsed/warc_xml_staged.jsonl
data/guidelines/raw/
